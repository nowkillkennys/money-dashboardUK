FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
FROM base AS dependencies
ENV CI=true NEXT_TELEMETRY_DISABLED=1
RUN npm install --global --ignore-scripts pnpm@10.28.2
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
FROM dependencies AS build
ENV UK_DEMO_ONLY=false NEXT_PUBLIC_UK_DEMO_ONLY=false WORKSPACE_MODE=authenticated
RUN --network=none pnpm build
FROM base AS workspace
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 UK_DEMO_ONLY=false NEXT_PUBLIC_UK_DEMO_ONLY=false WORKSPACE_MODE=authenticated
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/package.json /app/next.config.mjs ./
COPY --from=build --chown=node:node /app/scripts/workspace-start.cjs ./scripts/workspace-start.cjs
USER node
CMD ["node","scripts/workspace-start.cjs"]
FROM dependencies AS workspace-test
CMD ["pnpm","exec","vitest","run","--config","vitest.workspace.config.ts"]
FROM mcr.microsoft.com/playwright:v1.62.1-noble AS workspace-browser
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json playwright.workspace.config.ts ./
COPY e2e ./e2e
COPY lib/workspace ./lib/workspace
CMD ["node","node_modules/@playwright/test/cli.js","test","--config=playwright.workspace.config.ts"]
