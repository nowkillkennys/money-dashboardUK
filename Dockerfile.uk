FROM node:22-bookworm-slim AS dependencies
ENV CI=true NEXT_TELEMETRY_DISABLED=1
RUN npm install --global --ignore-scripts pnpm@10.28.2
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .

FROM dependencies AS build
ENV UK_DEMO_ONLY=true NEXT_PUBLIC_UK_DEMO_ONLY=true
RUN --network=none pnpm run build

FROM node:22-bookworm-slim AS preview
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 UK_DEMO_ONLY=true NEXT_PUBLIC_UK_DEMO_ONLY=true
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/next.config.mjs ./
COPY --from=build --chown=node:node /app/scripts/uk-preview-start.cjs ./scripts/uk-preview-start.cjs
USER node
EXPOSE 3000
CMD ["node","scripts/uk-preview-start.cjs"]

FROM mcr.microsoft.com/playwright:v1.62.1-noble AS browser-test
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json playwright.uk.config.ts ./
COPY e2e ./e2e
CMD ["node","node_modules/@playwright/test/cli.js","test","--config=playwright.uk.config.ts"]
